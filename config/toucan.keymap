#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define NAV2 3
#define FUNC 4
#define MACR 5

/ {
    macros {
        m_save: m_save {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LG(S))>;
        };
        m_oros: m_oros {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&kp LALT &macro_wait_time 30 &kp O &kp R &kp O &kp S &kp RET>;
        };
        m_o0: m_o0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&kp LALT &macro_wait_time 30 &kp O &kp N0>;
        };
        m_o9: m_o9 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&kp LALT &macro_wait_time 30 &kp O &kp N9>;
        };
        m_ows: m_ows {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&kp LALT &macro_wait_time 30 &kp O &kp W &kp S>;
        };
        m_oan: m_oan {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&kp LALT &macro_wait_time 30 &kp O &kp A &kp N &kp RET>;
        };
        m_b2vt: m_b2vt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&kp LALT &macro_wait_time 30 &kp B &kp N2 &kp V &kp T>;
        };
        m_ohfr: m_ohfr {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&kp LALT &macro_wait_time 30 &kp O &kp H &kp F &kp R>;
        };
        m_oocc: m_oocc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&kp LALT &macro_wait_time 30 &kp O &kp O &kp C &kp C>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
                &mo NAV   &kp SQT  &kp COMMA &kp DOT &kp P &kp Y     &kp F     &kp G     &kp C     &kp R   &kp L  &kp BSPC
                &mo SYM   &kp A    &kp O     &kp E   &kp U &kp I     &kp D     &kp H     &kp T     &kp N   &kp S  &kp MINUS
                &kp LSHFT &kp SEMI &kp Q     &kp J   &kp K &kp X     &kp B     &kp M     &kp W     &kp V   &kp Z  &kp RSHFT
                                       &kp TAB &kp RET &kp ESC       &kp RCTRL &kp SPACE &kp RALT
            >;
        };

        nav {
            display-name = "NAV";
            bindings = <
                &trans &none &none    &none     &none     &none     &none     &none      &kp UP   &none      &none &kp Z
                &none  &none &kp LALT &kp LCTRL &kp LSHFT &none     &none     &kp LEFT   &kp DOWN &kp RIGHT  &none &kp Y
                &none  &none &none    &none     &kp RGUI  &none     &none     &none      &none    &none      &none &none
                                            &kp C &kp V &kp X       &kp RCTRL &mo NAV2   &kp SPACE
            >;
        };

        sym {
            display-name = "SYM";
            bindings = <
                &none  &none &none    &none     &none     &none     &kp GRAVE &kp N1   &kp N2  &kp N3  &kp LBKT  &kp RBKT
                &trans &none &kp LALT &kp LCTRL &kp LSHFT &none     &kp BSLH  &kp N4   &kp N5  &kp N6  &kp DOT   &kp EQUAL
                &none  &none &none    &none     &kp RGUI  &none     &kp FSLH  &kp N7   &kp N8  &kp N9  &kp COMMA &kp MINUS
                                       &mo MACR &kp RET &kp ESC     &mo FUNC  &kp N0   &kp CAPS
            >;
        };

        nav2 {
            display-name = "NAV2";
            bindings = <
                &trans &none &none    &none     &none     &none     &none &none    &kp PG_UP &none   &none &kp DEL
                &none  &none &kp LALT &kp LCTRL &kp LSHFT &none     &none &kp HOME &kp PG_DN &kp END &none &none
                &none  &none &none    &none     &kp RGUI  &none     &none &none    &none     &none   &none &none
                                       &kp TAB &kp RET &kp ESC      &none &trans   &none
            >;
        };

        func {
            display-name = "FUNC";
            bindings = <
                &none  &none &none    &none     &none     &none     &none  &kp F1 &kp F2 &kp F3 &kp F10 &none
                &trans &none &kp LALT &kp LCTRL &kp LSHFT &none     &none  &kp F4 &kp F5 &kp F6 &kp F11 &none
                &none  &none &none    &none     &kp RGUI  &none     &none  &kp F7 &kp F8 &kp F9 &kp F12 &none
                                            &none &none &none       &trans &none  &none
            >;
        };

        macr {
            display-name = "MACR";
            bindings = <
                &none  &none &none    &none     &none     &none     &none   &m_oros &m_ows  &m_oan &none &none
                &trans &none &kp LALT &kp LCTRL &kp LSHFT &none     &m_save &m_o0   &m_b2vt &m_o9  &none &none
                &none  &none &none    &none     &kp RGUI  &none     &none   &m_ohfr &none   &none  &none &none
                                          &trans &none &none        &none   &m_oocc &none
            >;
        };
    };
};
